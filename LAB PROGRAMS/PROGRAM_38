    determinant = (p11 * p22 - p12 * p21) % 26

    inverse = -1

    for i in range(26):
        if (determinant * i) % 26 == 1:
            inverse = i
            break

    if inverse == -1:
        print("The plaintext matrix cannot be inverted modulo 26.")
    else:

        inv11 = (p22 * inverse) % 26
        inv12 = (-p12 * inverse) % 26
        inv21 = (-p21 * inverse) % 26
        inv22 = (p11 * inverse) % 26

        k11 = (c11 * inv11 + c12 * inv21) % 26
        k12 = (c11 * inv12 + c12 * inv22) % 26

        k21 = (c21 * inv11 + c22 * inv21) % 26
        k22 = (c21 * inv12 + c22 * inv22) % 26

